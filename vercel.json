{
  "services": {
    "frontend": {
      "root": "frontend/",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/shringar-frontend/browser"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server.js",
      "framework": "express",
      "installCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
