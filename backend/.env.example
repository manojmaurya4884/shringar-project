# Copy this file to ".env" and fill in real values. Never commit ".env" itself.

# Server
PORT=5000

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/shringar
# MongoDB Atlas (free tier): get this from atlas.mongodb.com after creating a cluster
MONGO_URI=mongodb://127.0.0.1:27017/shringar

# JWT secret - use a long random string in production
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# First admin account, created by "npm run seed:admin"
ADMIN_EMAIL=admin@shringarbylakshuu.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:4200

# Vercel Blob — create a Blob store in the Vercel dashboard and paste the
# read-write token here (never commit the real value).
BLOB_READ_WRITE_TOKEN=replace_with_vercel_blob_read_write_token